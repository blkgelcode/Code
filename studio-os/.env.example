# ─────────────────────────────────────────────────────────────────────────────
#  BLKGRLCO Studio OS — every key and setting, in one file.
#
#  ./install.sh copies this to .env (which is gitignored and chmod 600) and
#  fills in every "GENERATED" value for you. You only paste in the API keys.
#  After changing .env, run ./stop.sh then ./start.sh.
#
#  Never commit .env. Never paste these values into a chat, a doc or a ticket.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ SETTINGS ════════════════════════════════════════════════════════════════

# Which optional services run. Pick ONE video tool:
#   open-higgsfield      (default)  or  open-generative-ai  (fallback)
# Add ",public" to switch on the Cloudflare tunnel (see the bottom of this file).
COMPOSE_PROFILES=open-higgsfield

# Cal.com image. Apple Silicon needs the "-arm" tag; Intel Macs use v6.2.0.
# ./preflight.sh sets this for your chip.
CALCOM_IMAGE_TAG=v6.2.0-arm

# Chatwoot image (community edition, works on Apple Silicon and Intel).
CHATWOOT_IMAGE_TAG=v4.19.1-ce

# OpenSEO sign-in. "password": the first visitor creates the admin account.
# "local_noauth": no sign-in at all (fine here, since it's only on 127.0.0.1).
SEO_AUTH_MODE=password

# Where OpenHiggsfield sends generation jobs (Higgsfield's official API).
HF_API_BASE_URL=https://platform.higgsfield.ai

# Tools to keep switched off, comma-separated (ids: video, voice, seo, notes,
# dictation, calcom, chatwoot, record). Handy on an 8 GB Mac, e.g. STUDIO_DISABLED=seo
STUDIO_DISABLED=

# Also copy every ./backup.sh to an external drive (skipped if it's unplugged).
# e.g. BACKUP_COPY_TO=/Volumes/T7/studio-os-backups
BACKUP_COPY_TO=


# ═══ API KEYS YOU GET (paste them after the = sign) ═════════════════════════

# ── 1. Video & image: OpenHiggsfield (default video tool) ──
# REQUIRED. Your Higgsfield API key, written as  id:secret
# Cost: pay per generation, about $0.08 per second of video (no subscription).
# Get it: https://platform.higgsfield.ai  → API keys
# NOTE: the app can't read this file. Paste the key into its "Add key" box
# once; this line is your master copy, and the hub's Status tab checks for it.
HIGGSFIELD_API_KEY=

# OPTIONAL. Vercel Blob read-write token, only needed to UPLOAD start/end
# frames or reference images. Text-to-video works without it.
# Cost: free on Vercel's Hobby plan.
# Get it: https://vercel.com/dashboard → Storage → Create → Blob → .env.local tab
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# ── 1b. Video & image: Open Generative AI (fallback video tool) ──
# REQUIRED only if COMPOSE_PROFILES uses open-generative-ai.
# Cost: pay per generation; the price depends on the model.
# Get it: https://muapi.ai  → Dashboard → API keys
# NOTE: paste it into the app's settings too (it keeps it in your browser).
MUAPI_API_KEY=

# ── 2. Voice: VoiceStudio ──
# OPTIONAL. Hugging Face token: faster model downloads, and needed for the
# speaker-separation model. Cost: free.
# Get it: https://huggingface.co/settings/tokens  (a "Read" token is enough)
# NOTE: paste it in VoiceStudio → Settings → Credentials.
HF_TOKEN=

# ── 3. SEO: OpenSEO ──
# REQUIRED for any SEO data. It's your DataForSEO login and password,
# base64-encoded. Run  ./install.sh dataforseo-key  to make it for you.
# Cost: $50 minimum top-up (the balance never expires), then pay as you go,
# roughly $0.03 to $0.05 per keyword search. New accounts get $1 free credit.
# Get it: https://app.dataforseo.com/api-access
DATAFORSEO_API_KEY=

# OPTIONAL. Powers SAM, OpenSEO's AI assistant. Cost: pay as you go (cents).
# Get it: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# OPTIONAL. Link Google Search Console / Analytics. Cost: free.
# Get it: https://console.cloud.google.com/apis/credentials → OAuth client (Web)
# Redirect URLs: http://localhost:4102/api/gsc/oauth/callback
#                http://localhost:4102/api/ga4/oauth/callback
SEO_GOOGLE_CLIENT_ID=
SEO_GOOGLE_CLIENT_SECRET=
# OPTIONAL extras: map tiles for Local SEO, JavaScript rendering for audits.
SEO_GOOGLE_MAPS_API_KEY=
SEO_CONTEXT_API_KEY=

# ── 4. Notes: AppFlowy ──
# No keys. Works fully offline. (AppFlowy Cloud sync is optional, set up in the app.)

# ── 5. Dictation: OpenWhispr ──
# OPTIONAL. Only if you want CLOUD transcription; local Whisper/Parakeet is free.
# NOTE: paste whichever you use into OpenWhispr's settings.
# OpenAI: https://platform.openai.com/api-keys   (pay as you go)
OPENAI_API_KEY=
# Groq:   https://console.groq.com/keys          (free tier)
GROQ_API_KEY=

# ── 6 & 7. Email for Cal.com and Chatwoot ──
# RECOMMENDED. Without email, brands don't get booking confirmations and
# Chatwoot can't send replies or password resets.
# Cost: free. Resend (3,000 emails a month): host smtp.resend.com, port 587,
#   user "resend", password = your Resend API key. https://resend.com/api-keys
# Or a Gmail app password: host smtp.gmail.com, port 587, user = your Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
# The "from" address, e.g.  BLKGRLCO Studios <hello@yourdomain.com>
SMTP_FROM=

# ── 6. Cal.com ──
# OPTIONAL. Google Calendar sync: the OAuth client JSON on ONE line,
# wrapped in single quotes:  CALCOM_GOOGLE_API_CREDENTIALS='{"web":{...}}'
# Cost: free. Get it: https://console.cloud.google.com/apis/credentials
# Redirect URL: http://localhost:4103/api/integrations/googlecalendar/callback
CALCOM_GOOGLE_API_CREDENTIALS=

# ── 8. Screen recording: Cap ──
# No keys. Recording and exporting are free and local.


# ═══ OPTIONAL: LET BRANDS REACH YOU (Cloudflare Tunnel) ══════════════════════
# Booking links and website chat only work for other people if they can
# reach your Mac. Free, but you need a domain on Cloudflare (~$10/year).
# Get the token: https://one.dash.cloudflare.com → Networks → Tunnels → Create
# Then add ",public" to COMPOSE_PROFILES and fill in your public addresses:
CLOUDFLARE_TUNNEL_TOKEN=
# e.g. https://book.yourdomain.com  (leave empty to stay localhost-only)
CALCOM_PUBLIC_URL=
# e.g. https://inbox.yourdomain.com
CHATWOOT_PUBLIC_URL=


# ═══ GENERATED (./install.sh fills these in; don't edit or share them) ══════
SEO_STORAGE_ACCESS_KEY=openseo
SEO_STORAGE_SECRET_KEY=
CALCOM_DB_PASSWORD=
CALCOM_NEXTAUTH_SECRET=
CALCOM_ENCRYPTION_KEY=
CALCOM_VAPID_PUBLIC_KEY=
CALCOM_VAPID_PRIVATE_KEY=
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_DB_PASSWORD=
CHATWOOT_REDIS_PASSWORD=
