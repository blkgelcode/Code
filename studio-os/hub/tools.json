  "keys": [
    {
      "name": "HIGGSFIELD_API_KEY",
      "tool": "video",
      "variant": "open-higgsfield",
      "need": "required",
      "where": "Paste into OpenHiggsfield's \"Add key\" box (keep the master copy in .env)",
      "cost": "Pay per generation, about $0.08 per second of video (an 8s Kling 3.0 clip is about $0.67)",
      "get": "https://platform.higgsfield.ai"
    },
    {
      "name": "OPEN_HIGGSFIELD_READ_WRITE_TOKEN",
      "tool": "video",
      "variant": "open-higgsfield",
      "need": "optional",
      "where": ".env (read by the container)",
      "cost": "Free on Vercel's Hobby plan. Only needed to upload start frames or reference images",
      "get": "https://vercel.com/dashboard (Storage, then Blob, then Create)"
    },
    {
      "name": "MUAPI_API_KEY",
      "tool": "video",
      "variant": "open-generative-ai",
      "need": "required",
      "where": "Paste into Open Generative AI's settings (keep the master copy in .env)",
      "cost": "Pay per generation; price depends on the model",
      "get": "https://muapi.ai"
    },
    {
      "name": "HF_TOKEN",
      "tool": "voice",
      "need": "optional",
      "where": "VoiceStudio Settings, then Credentials",
      "cost": "Free",
      "get": "https://huggingface.co/settings/tokens"
    },
    {
      "name": "DATAFORSEO_API_KEY",
      "tool": "seo",
      "need": "required",
      "where": ".env (read by OpenSEO)",
      "cost": "$50 minimum top-up that never expires, then about $0.03 to $0.05 per keyword search",
      "get": "https://app.dataforseo.com/api-access (run ./install.sh dataforseo-key to format it)"
    },
    {
      "name": "OPENROUTER_API_KEY",
      "tool": "seo",
      "need": "optional",
      "where": ".env (powers OpenSEO's AI assistant, SAM)",
      "cost": "Pay as you go; usually cents per conversation",
      "get": "https://openrouter.ai/keys"
    },
    {
      "name": "SEO_GOOGLE_CLIENT_ID",
      "tool": "seo",
      "need": "optional",
      "where": ".env (Google Search Console link)",
      "cost": "Free",
      "get": "https://console.cloud.google.com/apis/credentials"
    },
    {
      "name": "SEO_GOOGLE_CLIENT_SECRET",
      "tool": "seo",
      "need": "optional",
      "where": ".env (Google Search Console link)",
      "cost": "Free",
      "get": "https://console.cloud.google.com/apis/credentials"
    },
    {
      "name": "OPENAI_API_KEY",
      "tool": "dictation",
      "need": "optional",
      "where": "OpenWhispr settings, only if you want cloud transcription",
      "cost": "Pay as you go; local transcription is free",
      "get": "https://platform.openai.com/api-keys"
    },
    {
      "name": "GROQ_API_KEY",
      "tool": "dictation",
      "need": "optional",
      "where": "OpenWhispr settings, only if you want cloud transcription",
      "cost": "Free tier available",
      "get": "https://console.groq.com/keys"
    },
    {
      "name": "SMTP_HOST",
      "tool": "calcom",
      "need": "recommended",
      "where": ".env (Cal.com and Chatwoot send email with it)",
      "cost": "Free: Resend (3,000 emails a month) or a Gmail app password",
      "get": "https://resend.com/api-keys"
    },
    {
      "name": "SMTP_USER",
      "tool": "calcom",
      "need": "recommended",
      "where": ".env",
      "cost": "Free",
      "get": "Same place as SMTP_HOST"
    },
    {
      "name": "SMTP_PASSWORD",
      "tool": "calcom",
      "need": "recommended",
      "where": ".env",
      "cost": "Free",
      "get": "Same place as SMTP_HOST"
    },
    {
      "name": "SMTP_FROM",
      "tool": "calcom",
      "need": "recommended",
      "where": ".env",
      "cost": "Free",
      "get": "An address on a domain you've verified with your email provider"
    },
    {
      "name": "CALCOM_GOOGLE_API_CREDENTIALS",
      "tool": "calcom",
      "need": "optional",
      "where": ".env (Google Calendar sync)",
      "cost": "Free",
      "get": "https://console.cloud.google.com/apis/credentials"
    },
    {
      "name": "CLOUDFLARE_TUNNEL_TOKEN",
      "tool": "calcom",
      "need": "optional",
      "where": ".env (lets brands reach Cal.com and Chatwoot)",
      "cost": "Free. You need a domain on Cloudflare (about $10 a year)",
      "get": "https://one.dash.cloudflare.com (Networks, then Tunnels)"
    }
  ],
