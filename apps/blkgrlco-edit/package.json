{
  "name": "blkgrlco-edit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local video editor whose whole edit lives in project/timeline.json, shared live between the browser and Claude Code.",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "vite build && node scripts/build.mjs",
    "app": "npm run build && electron .",
    "start": "npm run build && node dist-server/server.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "bge": "tsx scripts/bge.ts",
    "test:electron": "npm run build && node test/electron.cjs",
    "test:editing": "node test/editing.cjs",
    "test:playback": "npm run build && node test/playback.cjs"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "express": "4.21.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "^33.2.1",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.49.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "5.4.11",
    "zod": "^3.23.8"
  },
  "main": "dist-electron/main.cjs"
}
